{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Meridian",
	"version": "0.1.0",
	"identifier": "com.fatuousnerd.tauri",
	"build": {
		"beforeDevCommand": "bun dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun typescript",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Meridian — Trading Terminal",
				"width": 1360,
				"height": 860,
				"minWidth": 1024,
				"minHeight": 680,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
